    <!-- http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#afecta -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#afecta">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#afectado_por"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#Amenaza"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#Activo"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#afectado_por -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#afectado_por">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#Activo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#Amenaza"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#mitiga -->

