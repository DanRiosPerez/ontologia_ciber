        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#Control"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuariocc10/ontologies/2026/3/ciberseguridad#Amenaza"/>
